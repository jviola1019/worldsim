{
  "name": "epoch-civilizations-unbound",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "EPOCH: Civilizations Unbound - a pixel-art civilization god simulator for mobile and desktop browsers",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "preview:lan": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "tsx scripts/run-sim.ts",
    "stats": "tsx scripts/multi-seed.ts",
    "bench": "tsx benchmarks/sim-bench.ts",
    "bench:browser": "node benchmarks/browser-bench.mjs",
    "e2e": "node tests/e2e/run-e2e.mjs",
    "sprites": "tsx tools/render-sprites.ts",
    "sprites:sheet": "tsx tools/contact-sheet.ts"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@fontsource/pixelify-sans": "5.3.0",
    "preact": "11.2.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "fake-indexeddb": "6.2.8",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
